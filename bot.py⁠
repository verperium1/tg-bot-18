MODES = {
    "truth": ("🔥 Пикантная правда", TRUTH),
    "dare": ("⚡ Жесткое действие", DARE),
    "never": ("🔞 Я никогда не...", NEVER),
}
LEVEL_NAMES = {1: "Разогрев", 2: "Жарко", 3: "10/10 (Без цензуры)"}

# По умолчанию ставим максимальный уровень (3) для каждой сессии
levels: dict[int, int] = {}

dp = Dispatcher()


def main_kb(chat_id: int) -> InlineKeyboardMarkup:
    lvl = levels.get(chat_id, 3)
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text="🔥 Правда", callback_data="play:truth"),
                InlineKeyboardButton(text="⚡ Действие", callback_data="play:dare"),
            ],
            [
                InlineKeyboardButton(text="🔞 Я никогда не...", callback_data="play:never"),
                InlineKeyboardButton(text="🌹 Позы", callback_data="pose"),
            ],
            [InlineKeyboardButton(text=f"🎚 Уровень: {LEVEL_NAMES[lvl]}", callback_data="level")],
        ]
    )


def card_kb(mode: str) -> InlineKeyboardMarkup:
    skip = "pose" if mode == "pose_next" else f"play:{mode}"
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(text="⏭ Другое", callback_data=skip),
                InlineKeyboardButton(text="☰ Меню", callback_data="menu"),
            ]
        ]
    )


BANNER = Path(__file__).parent / "banner.png"
WELCOME = (
    "<b>🔥 Жесткая игра 10/10 для двоих на расстоянии</b>\n"
    "Никаких пресностей. Играйте на максимум.\n\n"
    "Выберите режим 👇"
)


@dp.message(Command("start"))
async def start(message: Message):
    levels.setdefault(message.chat.id, 3)  # Сразу включаем самый жесткий уровень
    kb = main_kb(message.chat.id)
    if BANNER.exists():
        await message.answer_photo(FSInputFile(BANNER), caption=WELCOME, reply_markup=kb, parse_mode="HTML")
    else:
        await message.answer(WELCOME, reply_markup=kb, parse_mode="HTML")


@dp.callback_query(F.data == "menu")
async def menu(call: CallbackQuery):
    await call.message.answer("Выберите режим 👇", reply_markup=main_kb(call.message.chat.id))
    await call.answer()


@dp.callback_query(F.data == "level")
async def change_level(call: CallbackQuery):
    chat_id = call.message.chat.id
    levels[chat_id] = levels.get(chat_id, 3) % 3 + 1
    await call.message.edit_reply_markup(reply_markup=main_kb(chat_id))
    await call.answer(f"Уровень: {LEVEL_NAMES[levels[chat_id]]}")


@dp.callback_query(F.data.startswith("play:"))
async def play(call: CallbackQuery):
    mode = call.data.split(":")[1]
    title, pool = MODES[mode]
    lvl = levels.get(call.message.chat.id, 3)
    text = random.choice(pool[lvl])
    await call.message.answer(
        f"<b>{title}</b> · {LEVEL_NAMES[lvl]}\n\n{text}", reply_markup=card_kb(mode), parse_mode="HTML"
    )
    await call.answer()


POSES_DIR = Path(__file__).parent / "poses"
IMG_EXT = {".jpg", ".jpeg", ".png", ".webp"}


@dp.callback_query(F.data == "pose")
async def pose(call: CallbackQuery):
    files = [f for f in POSES_DIR.glob("*") if f.suffix.lower() in IMG_EXT] if POSES_DIR.exists() else []
    if not files:
        await call.message.answer("Папка poses пуста. Можете закинуть туда фото.")
        await call.answer()
        return
    f = random.choice(files)
    await call.message.answer_photo(FSInputFile(f), caption=f.stem, reply_markup=card_kb("pose_next"))
    await call.answer()


async def main():
    bot = Bot(TOKEN)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
